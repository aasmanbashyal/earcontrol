{
  "name": "earcontrol",
  "private": true,
  "packageManager": "bun@1.3.10",
  "scripts": {
    "setup": "pwsh -NoProfile -File scripts/windows.ps1 -Task Setup",
    "dev": "pwsh -NoProfile -File scripts/windows.ps1 -Task Dev",
    "check": "pwsh -NoProfile -File scripts/windows.ps1 -Task Check",
    "test": "pwsh -NoProfile -File scripts/windows.ps1 -Task Test",
    "test:windows": "pwsh -NoProfile -File scripts/windows.ps1 -Task WindowsTest",
    "build": "pwsh -NoProfile -File scripts/windows.ps1 -Task Build",
    "package": "pwsh -NoProfile -File scripts/windows.ps1 -Task Package",
    "release:verify": "pwsh -NoProfile -File scripts/verify-release.ps1",
    "bench": "pwsh -NoProfile -File scripts/windows.ps1 -Task Bench",
    "demo:preview": "bun run --cwd media/launch/composition preview",
    "demo:check": "bun run --cwd media/launch/composition check",
    "demo:render": "bun scripts/render-demo.ts"
  },
  "license": "MIT"
}
